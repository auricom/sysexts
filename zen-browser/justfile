name := "zen-browser"
packages := "zen-browser"
copr_repos := "sneexy/zen-browser"

import '../sysext.just'

all: default

# Debian box for distrobox-build: it has every build tool, podman is forwarded
# to the host
distrobox_name := "sysext-builder"
distrobox_image := "docker.io/library/debian:stable"

# Build inside a Debian distrobox: the host only needs just, distrobox, podman
distrobox-build target arch=arch:
    #!/bin/bash
    set -euo pipefail
    if [[ -n "{{debug}}" ]]; then
      set -x
    fi

    if ! podman container exists "{{distrobox_name}}"; then
        distrobox create --yes --name "{{distrobox_name}}" --image "{{distrobox_image}}" \
            --additional-packages "just cpio erofs-utils jq rpm rpm2cpio curl"
    fi

    # Clean PATH: the host one can hold mise shims that break in the box
    box() {
        distrobox enter "{{distrobox_name}}" -- env PATH=/usr/local/bin:/usr/bin:/bin "${@}"
    }
    # distrobox-host-exec runs the command named like its symlink on the host
    box sudo ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/podman
    # Install host-spawn now so the build never stops on its download prompt
    box distrobox-host-exec --yes true
    box just build "{{target}}" "{{arch}}"

install-manual:
    #!/bin/bash
    set -euo pipefail
    if [[ -n "{{debug}}" ]]; then
      set -x
    fi

    if [[ "${UID}" == "0" ]]; then
        SUDO=""
    else
        SUDO="sudo"
    fi

    cd rootfs

    # sysexts can not ship /opt: move Zen to /usr/lib/zen
    ${SUDO} install -d -m 0755 usr/lib
    ${SUDO} mv opt/zen usr/lib/zen
    ${SUDO} sed -i 's|/opt/zen/|/usr/lib/zen/|g' usr/bin/zen-browser
    # Re-point the hicolor icon symlinks (and any other link) into /opt/zen
    for l in $(find usr -lname '*opt/zen/*'); do
        ${SUDO} ln -sfn "/usr/lib/zen/$(readlink "${l}" | sed 's|.*opt/zen/||')" "${l}"
    done

    # Fail the build if anything still points at /opt
    if grep -rIl '/opt/zen' usr/bin usr/share || [[ -n "$(find usr -lname '*opt/*')" ]]; then
        echo "❌ Leftover references to /opt/zen"
        exit 1
    fi
